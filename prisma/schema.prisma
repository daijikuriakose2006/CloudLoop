generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { ADMIN STAFF CUSTOMER }
enum BillingPeriod { DAILY WEEKLY MONTHLY YEARLY }
enum SubscriptionStatus { DRAFT QUOTATION CONFIRMED ACTIVE PAUSED CLOSED CANCELLED }
enum InvoiceStatus { DRAFT CONFIRMED PAID CANCELLED OVERDUE }
enum PaymentMethod { RAZORPAY BANK_TRANSFER CASH MANUAL }
enum DiscountType { FIXED PERCENTAGE }

model Profile {
  id String @id @db.Uuid
  email String @unique
  fullName String?
  role Role @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer?
  auditLogs AuditLog[]
  @@map("profiles")
}
model Customer {
  id String @id @default(cuid())
  profileId String? @unique @db.Uuid
  name String
  email String @unique
  phone String?
  billingAddress Json?
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  quotations Quotation[]
  subscriptions Subscription[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("customers")
}
model Product {
  id String @id @default(cuid())
  name String
  type String
  salesPrice Decimal @db.Decimal(12,2)
  costPrice Decimal @db.Decimal(12,2)
  notes String?
  active Boolean @default(true)
  variants ProductVariant[]
  plans Plan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("products")
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  name String
  priceAdjustment Decimal @default(0) @db.Decimal(12,2)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, name])
  @@map("product_variants")
}
model Plan {
  id String @id @default(cuid())
  productId String
  name String
  price Decimal @db.Decimal(12,2)
  billingPeriod BillingPeriod
  minimumQuantity Int @default(1)
  availableFrom DateTime?
  availableTo DateTime?
  autoCloseAtEnd Boolean @default(false)
  allowEarlyClose Boolean @default(true)
  allowPause Boolean @default(true)
  allowRenew Boolean @default(true)
  active Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  @@map("plans")
}
model Tax {
  id String @id @default(cuid())
  name String @unique
  rate Decimal @db.Decimal(5,2)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@map("taxes")
}
model Discount {
  id String @id @default(cuid())
  name String
  type DiscountType
  value Decimal @db.Decimal(12,2)
  minimumPurchase Decimal? @db.Decimal(12,2)
  minimumQuantity Int?
  startsAt DateTime
  endsAt DateTime?
  usageLimit Int?
  usageCount Int @default(0)
  productId String?
  active Boolean @default(true)
  @@index([active, startsAt, endsAt])
  @@map("discounts")
}
model Quotation {
  id String @id @default(cuid())
  number String @unique
  customerId String
  validUntil DateTime
  status SubscriptionStatus @default(DRAFT)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items QuotationItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("quotations")
}
model QuotationItem {
  id String @id @default(cuid())
  quotationId String
  productId String?
  planId String?
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  taxRate Decimal @default(0) @db.Decimal(5,2)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  @@map("quotation_items")
}
model Subscription {
  id String @id @default(cuid())
  number String @unique
  customerId String
  planId String
  status SubscriptionStatus @default(DRAFT)
  startDate DateTime
  expiryDate DateTime?
  nextBillingDate DateTime
  paymentTermsDays Int @default(0)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  items SubscriptionItem[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextBillingDate])
  @@map("subscriptions")
}
model SubscriptionItem {
  id String @id @default(cuid())
  subscriptionId String
  productId String?
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  taxRate Decimal @default(0) @db.Decimal(5,2)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@map("subscription_items")
}
model Invoice {
  id String @id @default(cuid())
  number String @unique
  subscriptionId String
  customerId String
  status InvoiceStatus @default(DRAFT)
  periodStart DateTime
  periodEnd DateTime
  dueDate DateTime
  subtotal Decimal @db.Decimal(12,2)
  discountAmount Decimal @default(0) @db.Decimal(12,2)
  taxAmount Decimal @default(0) @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines InvoiceLine[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([status, dueDate])
  @@index([customerId, createdAt])
  @@map("invoices")
}
model InvoiceLine {
  id String @id @default(cuid())
  invoiceId String
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  discountAmount Decimal @default(0) @db.Decimal(12,2)
  taxRate Decimal @default(0) @db.Decimal(5,2)
  amount Decimal @db.Decimal(12,2)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@map("invoice_lines")
}
model Payment {
  id String @id @default(cuid())
  invoiceId String
  method PaymentMethod
  amount Decimal @db.Decimal(12,2)
  paidAt DateTime
  note String?
  gatewayPaymentId String? @unique
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@map("payments")
}
model AuditLog {
  id String @id @default(cuid())
  actorId String? @db.Uuid
  action String
  entityType String
  entityId String
  metadata Json?
  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
  @@map("audit_logs")
}
model Notification {
  id String @id @default(cuid())
  profileId String? @db.Uuid
  type String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([profileId, readAt])
  @@map("notifications")
}
